# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed — never expose secrets to the client bundle.
# Only NEXT_PUBLIC_ prefixed vars are readable in the browser.

# Public site URL (used for SEO metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://lor-goderich.com

# --- Payment gateways (server-side only, plug in real credentials later) ---
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/sl/v1

AFRIMONEY_API_KEY=
AFRIMONEY_MERCHANT_ID=
AFRIMONEY_API_URL=https://api.africell.sl/afrimoney/v1

CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=
CARD_GATEWAY_API_URL=

# --- Analytics (optional, loaded only after cookie consent) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
